@contextlib.contextmanager
def quiet_logs():
    global QUIET
    previous, QUIET = QUIET, True
    try:
        yield
    finally:
        QUIET = previous


def doctor_checks(config: Path) -> dict:
    checks = []

    def record(name: str, state: str, detail: str) -> None:
        checks.append({"check": name, "state": state, "detail": detail})

    try:
        cfg = load_config(config)
        record("config", "ok", f"{len(cfg['apps'])} apps configured")
    except (OSError, ValueError, TypeError) as e:
        cfg = {"apps": []}
        record("config", "error", str(e))
    try:
        STATE.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryFile(dir=STATE):
            pass
        for name in ("listener.log", "inbox.jsonl", "seen.json", "status.json"):
            path = STATE / name
            if path.exists() and (not path.is_file() or not os.access(path, os.R_OK | os.W_OK)):
                raise OSError(f"{path} is not a readable, writable file")
        load_seen()
        read_status()
        record("state_directory", "ok", str(STATE))
    except (OSError, ValueError, TypeError) as e:
        record("state_directory", "error", str(e))
    if not shutil.which("xcrun"):
        record("devicectl", "error", "xcrun missing; select an Xcode installation")
    else:
        rc, _, err = run(["xcrun", "--find", "devicectl"], timeout=15)
        record("devicectl", "error" if rc else "ok", tail(err) if rc else "available")
        if not rc:
            with quiet_logs():
                try:
                    devices = list_devices()
                    if not devices:
                        record("devices", "warning", "no paired iPhone or iPad")
                    for dev in devices:
                        state = probe(dev)
                        record(f"device:{dev['dir']}", "ok" if state else "warning",
                               f"pairing={dev.get('pairing')}; reachable; locked={state['locked']}" if state
                               else f"pairing={dev.get('pairing')}; unreachable; check pairing and connection")
                except (OSError, ValueError, RuntimeError) as e:
                    record("devices", "error", str(e))
    if cfg.get("cloudkit"):
        cloud = cfg["cloudkit"]
        executable = Path(cloud["app"]) / "Contents/MacOS/BugKitCloudReader"
        rc, _, _ = run([str(executable), "--check-signing", "--container", cloud["container"], "--environment", cloud["environment"]], timeout=20)
        record("cloudkit_signing", "ok" if rc == 0 else "error",
               "provisioned container entitlement present; iCloud/network health requires a poll" if rc == 0
               else "build/install the signed headless app with the shared container entitlement and profile")
    for a in cfg["apps"]:
        if a.get("mac_dir"):
            root = Path(a["mac_dir"])
            accessible = root.is_dir() and os.access(root, os.R_OK | os.X_OK)
            record(f"mac_store:{a['name']}", "ok" if accessible else "warning",
                   "local storage root readable" if accessible else "store missing or unreadable; launch the app or check mac_dir")
        kind = a["tracker"]["kind"]
        name = f"tracker:{a['name']}"
        if kind == "none":
            record(name, "ok", "local inbox only")
        elif kind == "github":
            if not shutil.which("gh"):
                record(name, "error", "gh missing")
                continue
            rc, _, err = run(["gh", "auth", "status"], timeout=20)
            if rc:
                record(name, "error", "GitHub authentication failed; run gh auth login")
                continue
            rc, _, err = run(["gh", "issue", "list", "-R", a["tracker"]["repo"], "--limit", "1", "--json", "number"], timeout=30)
            record(name, "error" if rc else "ok", "cannot read repository issues: " + tail(err) if rc else "authenticated; issues readable")
        else:
            repo = Path(a["repo"])
            if not repo.is_dir() or not shutil.which("bd"):
                record(name, "error", "bd missing or local repository does not exist")
                continue
            rc, _, err = run(["bd", "status", "--json"], timeout=20, cwd=repo)
            record(name, "error" if rc else "ok", tail(err) if rc else "beads repository readable")
    record("notifications", "ok" if shutil.which("herdr") else "warning",
           "herdr available" if shutil.which("herdr") else "herdr missing; reports still reach the inbox")
    return {"schema_version": 1, "ok": not any(c["state"] == "error" for c in checks), "checks": checks}


@app.command()
def doctor(ctx: typer.Context, config: Optional[Path] = typer.Option(None, "--config"),
           json_output: bool = typer.Option(False, "--json", help="Emit one JSON object for agents.")) -> None:
    """Check setup, device reachability, tracker access and local storage without filing."""
    result = doctor_checks(config or ctx.obj["config"])
    if json_output:
        print(json.dumps(result))
    else:
        for check in result["checks"]:
            print(f"{check['state'].upper():7} {check['check']}: {check['detail']}")
    if not result["ok"]:
        raise typer.Exit(1)


@app.command()
def status(ctx: typer.Context, config: Optional[Path] = typer.Option(None, "--config"),
           json_output: bool = typer.Option(False, "--json", help="Emit one JSON object for agents.")) -> None:
    """Read the last poll and pending reports. Does not contact devices or trackers."""
    try:
        cfg = load_config(config or ctx.obj["config"])
        result = read_status()
        seen = load_seen()
        result["pending"] = [item for entry in seen.values() for item in entry.get("pending", {}).values()]
        completed = parse_time(result.get("last_poll_completed"))
        age = (dt.datetime.now(dt.timezone.utc) - completed).total_seconds() if completed else None
        stale = age is None or age > 2 * result.get("poll_seconds", cfg["poll_seconds"])
        result.update(schema_version=1, stale=stale, seconds_since_poll=round(age) if age is not None else None)
        result["ok"] = not (stale or result.get("last_error") or result["pending"]
                            or result.get("summary", {}).get("errors") or not result.get("summary", {}).get("reachable"))
    except (OSError, ValueError, TypeError, AttributeError) as e:
        result = {"schema_version": 1, "ok": False, "error": str(e)}
        print(json.dumps(result) if json_output else f"ERROR: {e}")
        raise typer.Exit(2)
    if json_output:
        print(json.dumps(result))
    else:
        print(f"Last completed poll: {result.get('last_poll_completed', 'never')}")
        print(f"Last successful poll: {result.get('last_successful_poll', 'never')}")
        print(f"In progress: {result.get('in_progress', False)}; stale: {stale}; pending: {len(result['pending'])}")
        if result.get("last_error"):
            print(f"Last error: {result['last_error']}")
        for item in result["pending"]:
            print(f"{item['app']} / {item['device']} {item['key']}: {item['reason']}")
    if not result["ok"]:
        raise typer.Exit(1)


@app.callback(invoke_without_command=True)
def main(
    ctx: typer.Context,
    once: bool = typer.Option(False, "--once", help="Poll once and exit."),
    dry_run: bool = typer.Option(False, "--dry-run", help="Copy and print without filing or updating delivery/health state."),
    interval: Optional[int] = typer.Option(None, "--interval", min=1, help="Seconds between polls (config: 300)."),
    backfill: bool = typer.Option(False, "--backfill", help="File existing reports and crashes on first contact."),
    config: Path = typer.Option(CONFIG, "--config", help="The apps file."),
) -> None:
    global DRY
    ctx.obj = {"config": config}
    if ctx.invoked_subcommand is not None:
        return
    DRY = dry_run
    try:
        cfg = load_config(config)
    except (OSError, ValueError, TypeError) as e:
        log("config_error", path=str(config), message=str(e))
        raise typer.Exit(2)
    every = interval if interval is not None else cfg["poll_seconds"]
    cfg["poll_seconds"] = every
    log("start", config=str(config), apps=len(cfg["apps"]), interval=every, once=once, backfill=backfill)
    while True:
        try:
            summary = poll(cfg, backfill)
            if once and (summary["errors"] or not summary["reachable"]):
                raise typer.Exit(1)
        except typer.Exit:
            raise
        except Exception as e:
            log("poll_error", message=repr(e), traceback=traceback.format_exc())
            if once:
                raise typer.Exit(1)
        if once:
            return
        time.sleep(every)


