#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["typer>=0.12"]
# ///
"""bug-listener: files new reports from paired iOS devices, configured local Mac stores and CloudKit.

Each poll, for each physical iOS device `devicectl` lists (and an app's `mac_dir` on this Mac, as device "mac")
and each app in ~/.config/bug-kit/apps.json:
copy Documents/bugs.jsonl and independently discover crash files; for each report not in the seen-store,
copy its folder and session evidence to ~/tmp/agent/bugs/<app>/<device>/, file it through the app's tracker, append a line
to ~/tmp/agent/bugs/inbox.jsonl and send a Herdr notification. Every step is a JSON line in
~/tmp/agent/bugs/listener.log.

The first time the listener meets an (app, device) pair it marks every report already there as seen without
filing it: the apps' own `just file-bugs` filed those. --backfill files them instead.
"""

from __future__ import annotations

import contextlib
import datetime as dt
import hashlib
import json
import os
import re
import shutil
import subprocess
import tempfile
import time
import traceback
import uuid
from pathlib import Path
from typing import Any, Optional

import typer

HOME = Path.home()
CONFIG = HOME / ".config" / "bug-kit" / "apps.json"
STATE = HOME / "tmp" / "agent" / "bugs"
LOG = STATE / "listener.log"
SEEN = STATE / "seen.json"
INBOX = STATE / "inbox.jsonl"
FIXED = {
    "id", "reported_at", "app", "bundle", "build", "commit", "device", "screen", "note", "log", "screenshot",
    "context", "session_t_ms", "folder", "files", "source", "reason",
}

app = typer.Typer(add_completion=False, help=__doc__)
DRY = False
QUIET = False


def now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def log(event: str, **fields: Any) -> None:
    """One JSON line per step in listener.log, and a short line on stdout for the pane."""
    if QUIET:
        return
    rec = {"t": now(), "event": event, **({"dry_run": True} if DRY else {}), **fields}
    STATE.mkdir(parents=True, exist_ok=True)
    with LOG.open("a") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    short = " ".join(f"{k}={v}" for k, v in fields.items() if k not in ("stderr", "traceback"))
    print(f"{rec['t'][11:19]} {event} {short}", flush=True)


def run(cmd: list[str], timeout: int = 120, cwd: Optional[Path] = None) -> tuple[int, str, str]:
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, cwd=cwd)
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired:
        return 124, "", f"timed out after {timeout} s"
    except FileNotFoundError as e:
        return 127, "", str(e)


def tail(text: str, lines: int = 4) -> str:
    """The last few non-blank lines of a command's stderr: enough to say why, short enough for one log line."""
    return " | ".join(l.strip() for l in text.splitlines() if l.strip())[-lines * 160:] if text else ""


def slug(text: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-") or "device"


# --- config and state ---------------------------------------------------------------------------------------


def load_config(path: Path) -> dict:
    cfg = json.loads(path.read_text())
    if not isinstance(cfg, dict) or not isinstance(cfg.get("apps"), list) or not cfg["apps"]:
        raise ValueError("config needs a nonempty apps array")
    names, bundles = set(), set()
    for a in cfg["apps"]:
        if not isinstance(a, dict):
            raise ValueError("each app must be an object")
        for key in ("name", "bundle"):
            if not isinstance(a.get(key), str) or not a[key].strip():
                raise ValueError(f"each app needs a nonempty {key}")
        if a["name"] in (".", "..") or "/" in a["name"] or a["name"] in names or a["bundle"] in bundles:
            raise ValueError("app names must be unique directory names; bundles must be unique")
        names.add(a["name"])
        bundles.add(a["bundle"])
        if "app_group" in a:
            group = a["app_group"]
            if not isinstance(group, str) or not re.fullmatch(r"group\.[A-Za-z0-9_.-]+", group):
                raise ValueError(f"{a['name']}: app_group must be an App Group identifier (group.…)")
        tracker = a.setdefault("tracker", {"kind": "none"})
        if not isinstance(tracker, dict) or tracker.get("kind") not in ("github", "beads", "none"):
            raise ValueError(f"{a['name']}: tracker.kind must be github, beads or none")
        if tracker["kind"] == "github" and not re.fullmatch(r"[^/\s]+/[^/\s]+", str(tracker.get("repo", ""))):
            raise ValueError(f"{a['name']}: GitHub tracker needs owner/repo")
        if tracker["kind"] == "beads" and not a.get("repo"):
            raise ValueError(f"{a['name']}: beads needs a local repo")
        for key, default in (("log_dir", "Documents/logs"), ("crash_dir", "Documents/crashes")):
            value = a.setdefault(key, default)
            if not isinstance(value, str) or not value or Path(value).is_absolute() or ".." in Path(value).parts:
                raise ValueError(f"{a['name']}: {key} must be relative to the app container")
        if a.get("repo"):
            a["repo"] = str(Path(a["repo"]).expanduser())
        if "mac_dir" in a:
            value = a["mac_dir"]
            if not isinstance(value, str) or not value or not Path(value).expanduser().is_absolute():
                raise ValueError(f"{a['name']}: mac_dir must be an absolute local storage root")
            root = Path(value).expanduser().resolve()
            state = STATE.resolve()
            if root.is_relative_to(state) or state.is_relative_to(root):
                raise ValueError(f"{a['name']}: mac_dir and listener state must not overlap")
            a["mac_dir"] = str(root)
    interval = cfg.setdefault("poll_seconds", 300)
    if isinstance(interval, bool) or not isinstance(interval, int) or interval <= 0:
        raise ValueError("poll_seconds must be a positive integer")
    if "cloudkit_config" in cfg:
        value = cfg["cloudkit_config"]
        if not isinstance(value, str) or not Path(value).expanduser().is_absolute():
            raise ValueError("cloudkit_config must be an absolute local JSON config path")
        cfg["cloudkit_config"] = str(Path(value).expanduser())
        cloud = json.loads(Path(cfg["cloudkit_config"]).read_text())
        if not isinstance(cloud, dict) or not isinstance(cloud.get("container"), str) or not re.fullmatch(r"iCloud\.[A-Za-z0-9.-]+", cloud["container"]):
            raise ValueError("CloudKit config needs a container identifier")
        if cloud.get("environment") not in ("Development", "Production"):
            raise ValueError("CloudKit environment must be Development or Production")
        for key in ("app", "inbox"):
            if not isinstance(cloud.get(key), str) or not Path(cloud[key]).expanduser().is_absolute():
                raise ValueError(f"CloudKit config needs an absolute {key} path")
            cloud[key] = str(Path(cloud[key]).expanduser())
        if not cloud["app"].endswith(".app"):
            raise ValueError("CloudKit reader must be a provisioned .app bundle")
        cfg["cloudkit"] = cloud
    return cfg


def load_seen() -> dict:
    if not SEEN.exists():
        return recover_deliveries({})
    data = json.loads(SEEN.read_text())
    if not isinstance(data, dict) or any(not isinstance(entry, dict) for entry in data.values()):
        raise ValueError("seen.json must map app/device pairs to state objects")
    return recover_deliveries(data)


def recover_deliveries(seen: dict) -> dict:
    if INBOX.is_file():
        by_name = {}  # legacy lines did not persist a bundle identifier
        for line in INBOX.read_text().splitlines():
            try:
                item = json.loads(line)
                if item.get("key") and item.get("bundle"):
                    seen.setdefault("_deliveries", {})[item["bundle"] + ":" + item["key"]] = {
                        "ref": item.get("ref"), "inbox": True}
                elif item.get("key") and item.get("app"):
                    by_name[item["app"] + ":" + item["key"]] = {"ref": item.get("ref")}
            except (ValueError, AttributeError, TypeError):
                continue
        seen["_inbox_deliveries"] = by_name
    return seen


def save_seen(seen: dict) -> None:
    if DRY:
        return
    STATE.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=STATE, prefix=".seen-")
    with os.fdopen(fd, "w") as f:
        json.dump(seen, f, indent=1, sort_keys=True)
    os.replace(tmp, SEEN)


# --- devices ------------------------------------------------------------------------------------------------


def list_devices() -> list[dict]:
    """Physical iPhones and iPads that devicectl knows (paired). Reachability is probed per poll."""
    with tempfile.TemporaryDirectory() as d:
        out = Path(d) / "devices.json"
        rc, _, err = run(["xcrun", "devicectl", "list", "devices", "--json-output", str(out)], timeout=60)
        if rc != 0 or not out.exists():
            log("devices_error", rc=rc, stderr=tail(err))
            raise RuntimeError(f"device discovery failed (exit {rc}): {tail(err)}")
        data = json.loads(out.read_text())
    devices, used = [], set()
    for d in data.get("result", {}).get("devices", []):
        hw, props = d.get("hardwareProperties", {}), d.get("deviceProperties", {})
        if hw.get("reality") != "physical" or hw.get("deviceType") not in ("iPhone", "iPad"):
            continue
        model = hw.get("marketingName") or hw.get("productType") or hw.get("deviceType")
        name = slug(model)
        while name in used:  # two of the same model
            name += "-b"
        used.add(name)
        devices.append({
            "id": d["identifier"], "model": model, "type": hw.get("deviceType"), "dir": name,
            "pairing": d.get("connectionProperties", {}).get("pairingState"),
            "transport": d.get("connectionProperties", {}).get("transportType"),
            "os": props.get("osVersionNumber"),
        })
    log("devices", count=len(devices), devices=[x["dir"] for x in devices])
    return devices


def probe(dev: dict) -> Optional[dict]:
    """Asks the device its lock state: the cheapest call that proves it is reachable. None when it is not."""
    with tempfile.TemporaryDirectory() as d:
        out = Path(d) / "lock.json"
        t0 = time.monotonic()
        rc, _, err = run(["xcrun", "devicectl", "device", "info", "lockState", "--device", dev["id"],
                          "--timeout", "30", "--json-output", str(out)], timeout=60)
        ms = int((time.monotonic() - t0) * 1000)
        if rc != 0 or not out.exists():
            log("device", device=dev["dir"], reachable=False, ms=ms, transport=dev["transport"], stderr=tail(err))
            return None
        res = json.loads(out.read_text()).get("result", {})
    state = {"locked": res.get("passcodeRequired"), "unlocked_since_boot": res.get("unlockedSinceBoot")}
    log("device", device=dev["dir"], reachable=True, ms=ms, transport=dev["transport"], os=dev["os"], **state)
    return state


def copy(dev: dict, a: dict, source: str, dest: Path, locked: Any, *, allow_missing: bool = False) -> bool:
    """devicectl copy from the configured app or App Group container. Paths are relative to that container."""
    if dev.get("type") == "Mac":
        return copy_mac(a, dev, source, dest, allow_missing=allow_missing)
    dest.parent.mkdir(parents=True, exist_ok=True)
    t0 = time.monotonic()
    rc, _, err = run(["xcrun", "devicectl", "device", "copy", "from", "--device", dev["id"],
                      "--domain-type", "appGroupDataContainer" if a.get("app_group") else "appDataContainer",
                      "--domain-identifier", a.get("app_group") or a["bundle"],
                      "--source", source, "--destination", str(dest), "--timeout", "90"], timeout=120)
    ms = int((time.monotonic() - t0) * 1000)
    missing = allow_missing and rc not in (0, 124, 127) and bool(re.search(
        r"no such file|file[^\n]*(?:does not exist|not found)|directory[^\n]*(?:does not exist|not found)", err, re.I))
    ok = (rc == 0 and dest.exists()) or missing
    fields = dict(device=dev["dir"], app=a["name"], source=source, ok=ok, ms=ms, locked=locked,
                  domain="appGroupDataContainer" if a.get("app_group") else "appDataContainer")
    if missing:
        fields["missing"] = True
    if not ok:
        fields.update(rc=rc, stderr=tail(err))
    log("copy", **fields)
    return ok


def copy_mac(a: dict, dev: dict, source: str, dest: Path, *, allow_missing: bool) -> bool:
    """Snapshot evidence without changing the app's store or following links outside its root."""
    started = time.monotonic()
    try:
        root = Path(a["mac_dir"])
        relative = source.removeprefix("Documents/")
        path = store_evidence_path(root, relative, scope="Mac")
        if not path.exists():
            if not allow_missing:
                raise FileNotFoundError("required local evidence is missing")
            log("copy", device=dev["dir"], app=a["name"], source=source, ok=True, missing=True, domain="mac_dir")
            return True
        dest.parent.mkdir(parents=True, exist_ok=True)
        if path.is_dir():
            # copytree would follow nested symlinks by default. Reject them before copying the snapshot.
            for child in path.rglob("*"):
                if child.is_symlink() or not (child.is_file() or child.is_dir()):
                    raise ValueError("local evidence contains a symbolic link or special file")
            shutil.copytree(path, dest, dirs_exist_ok=True)
        elif path.is_file():
            shutil.copy2(path, dest)
        else:
            raise ValueError("local evidence is not a regular file or directory")
        log("copy", device=dev["dir"], app=a["name"], source=source, ok=True, domain="mac_dir",
            ms=int((time.monotonic() - started) * 1000))
        return True
    except (OSError, ValueError) as error:
        log("copy", device=dev["dir"], app=a["name"], source=source, ok=False, domain="mac_dir",
            message=str(error), ms=int((time.monotonic() - started) * 1000))
        return False


# --- reports ------------------------------------------------------------------------------------------------


def report_key(rec: dict, line: str) -> str:
    """BugKit reports carry an id; older EA and CG lines are keyed by reported_at, as their file-bugs did."""
    return rec.get("id") or rec.get("reported_at") or "sha1:" + hashlib.sha1(line.encode()).hexdigest()[:16]


def read_index(path: Path, ctx: dict) -> list[tuple[str, dict]]:
    out = []
    # Split on "\n" only: str.splitlines() also breaks on U+2028, U+0085 and other characters that JSON allows raw
    # inside a string, which would cut a valid report in two. A line that still does not parse (an older app's
    # note with a raw newline) is logged and skipped, never fatal.
    for n, line in enumerate(path.read_text(errors="replace").split("\n"), 1):
        if not line.strip():
            continue
        try:
            rec = json.loads(line)
            if not isinstance(rec, dict):
                raise ValueError("not an object")
        except ValueError as e:
            log("line_unreadable", line=n, message=str(e), start=line[:80], **ctx)
            continue
        out.append((report_key(rec, line), rec))
    return out


def under_documents(rel: str) -> str:
    return rel if rel.startswith("Documents/") else f"Documents/{rel}"


def log_source(rec: dict, a: dict) -> Optional[str]:
    """BugKit's `log` is a path under Documents; the older apps wrote only the file name under Documents/logs."""
    name = rec.get("log")
    if not name:
        return None
    return under_documents(name) if "/" in name else f"{a['log_dir']}/{name}"


def folder_of(rec: dict) -> Optional[str]:
    if rec.get("folder"):
        return rec["folder"]
    shot = rec.get("screenshot")
    return str(Path(shot).parent) if shot else None


def is_auto(rec: dict) -> bool:
    """Saved by the app itself (BugKit's BugAutoReporter), not by a person."""
    return rec.get("source") == "auto"


def labels_of(rec: dict) -> list[str]:
    return ["bug", "auto"] if is_auto(rec) else ["bug"]


def beads_title(rec: dict) -> str:
    return title_of(rec) if is_auto(rec) else f"Bug: {title_of(rec)}"


def title_of(rec: dict) -> str:
    if is_auto(rec):
        return f"Automatic report: {rec.get('reason') or 'unknown'}"[:80]
    for line in (rec.get("note") or "").splitlines():
        line = re.sub(r"^[-* ]+", "", line).strip()
        if line:
            return line[:80]
    return f"Report from the device, {rec.get('reported_at', '?')}"


def cell(v: Any) -> str:
    if not isinstance(v, str):
        v = json.dumps(v, ensure_ascii=False)
    return v.replace("|", "\\|").replace("\n", " ") or "–"


def tilde(p: Path) -> str:
    return "~/" + str(p.relative_to(HOME)) if p.is_relative_to(HOME) else str(p)


def issue_body(rec: dict, key: str, dev: dict, a: dict, local: Path) -> str:
    """The issue text. The screenshot is named by its path on the Mac and never uploaded: the repos are public
    and a screenshot can show health, places or a journal (CG story 143)."""
    note = (rec.get("note") or "").replace("\n", "\n> ")
    rows = [("Reason", rec.get("reason") if is_auto(rec) else None), ("Screen", rec.get("screen")), ("Build", rec.get("build")), ("Commit", rec.get("commit")),
            ("Device", rec.get("device") or dev["model"])]
    log_name = rec.get("log")
    if log_name:
        at = f" at {rec['session_t_ms']} ms" if rec.get("session_t_ms") is not None else ""
        log_path = local / log_name if rec.get("kind") == "crash" or dev["type"] == "CloudKit" else local / "logs" / Path(log_name).name
        rows.append(("Log", f"`{log_name}`{at}, pulled to `{tilde(log_path)}`"))
    if rec.get("screenshot"):
        rows.append(("Screenshot", f"`{tilde(local / rec['screenshot'])}` on the Mac, not uploaded"))
    for f in rec.get("files") or []:
        rows.append(("File", f"`{tilde(local / f)}` on the Mac"))
    context = dict(rec.get("context") or {})
    context.update({k: v for k, v in rec.items() if k not in FIXED})  # older lines keep context at the top level
    rows += [(k, v) for k, v in sorted(context.items())]
    table = "\n".join(f"| {cell(k)} | {cell(v)} |" for k, v in rows if v is not None)
    markers = "" if rec.get("kind") == "crash" else f"<!-- bug:{rec.get('reported_at', '')} -->"
    if rec.get("id"):
        markers += f"\n<!-- bug-id:{rec['id']} -->"
    kind = "Automatic report" if is_auto(rec) else "Report"
    return (f"**{kind} from the {dev['type']}** ({a['name']}, pulled by bug-listener), {rec.get('reported_at', '?')}\n\n"
            f"> {note}\n\n| | |\n|---|---|\n{table}\n\n{markers}")


# --- trackers -----------------------------------------------------------------------------------------------


class Filer:
    """Files a report through its app's tracker. Returns the issue's url or id, or None on failure (left unseen,
    so the next poll tries again)."""

    def __init__(self) -> None:
        self.filed_markers: dict[str, Optional[set[str]]] = {}
        self.legacy_markers: dict[str, set[str]] = {}
        self.bodies: dict[str, list[str]] = {}

    def github_markers(self, repo: str) -> Optional[set[str]]:
        """The bodies' markers, read once per poll. A failed read stops filing (CG 6fed157): better late than twice."""
        if repo not in self.filed_markers:
            rc, out, err = run(["gh", "issue", "list", "-R", repo, "--state", "all", "--limit", "1000",
                                "--json", "body"], timeout=90)
            if rc != 0:
                log("tracker_error", tracker="github", repo=repo, step="list", rc=rc, stderr=tail(err))
                self.filed_markers[repo] = None
            else:
                try:
                    issues = json.loads(out)
                    if not isinstance(issues, list):
                        raise ValueError("issue list is not an array")
                    bodies = [issue.get("body") or "" for issue in issues]
                    self.filed_markers[repo] = set()
                    self.legacy_markers[repo] = set()
                    self.bodies[repo] = []
                    for body in bodies:
                        markers = set(re.findall(r"<!-- bug(?:-id)?:[^ ]+ -->", body))
                        self.filed_markers[repo].update(markers)
                        if not any(marker.startswith("<!-- bug-id:") for marker in markers):
                            self.legacy_markers[repo].update(markers)
                        if not markers:
                            self.bodies[repo].append(re.sub(r"\s+", " ", body))
                except (ValueError, TypeError, AttributeError) as e:
                    log("tracker_error", tracker="github", repo=repo, step="list", message=str(e))
                    self.filed_markers[repo] = None
        return self.filed_markers[repo]

    def check(self, a: dict, rec: dict) -> Optional[tuple[str, Optional[str]]]:
        """Before any copy: is the report already an issue (filed by the app's own `just file-bugs`, or by an
        earlier poll whose seen-store write was lost)? Returns an outcome to stop at, or None to go on."""
        if a["tracker"].get("kind") != "github":
            return None
        repo = a["tracker"]["repo"]
        markers = self.github_markers(repo)
        if markers is None:
            return "error", None
        at = rec.get("reported_at")
        # UUID reports can share a timestamp. Only use a timestamp to match an old issue without a UUID.
        timestamp_markers = self.legacy_markers.get(repo, set()) if rec.get("id") else markers
        if rec.get("kind") == "crash" or is_auto(rec):
            timestamp_markers = set()  # a manual report at this second is a different event
        if (rec.get("id") and f"<!-- bug-id:{rec['id']} -->" in markers) or (at and f"<!-- bug:{at} -->" in timestamp_markers):
            return "already_filed", repo
        # Some issues were filed without the marker (by hand, or by an older script), so the apps' own dedupe
        # missed them: a note whose first 60 characters already appear in a marker-free issue is taken as filed.
        note = "" if is_auto(rec) else re.sub(r"\s+", " ", rec.get("note") or "").strip()
        if rec.get("kind") != "crash" and len(note) >= 30 and any(note[:60] in body for body in self.bodies.get(repo, [])):
            log("possible_duplicate", repo=repo, reported_at=at, note=note[:60])
            return "already_filed", repo
        return None

    def file(self, a: dict, rec: dict, key: str, dev: dict, local: Path) -> tuple[str, Optional[str]]:
        kind = a["tracker"].get("kind", "none")
        title = title_of(rec)
        if kind == "none":
            return ("would_file", f"inbox only: {title}") if DRY else ("none", "inbox-only")
        if kind == "github":
            repo = a["tracker"]["repo"]
            at = rec.get("reported_at")
            if DRY:
                return "would_file", f"github {repo}: {title}"
            body = issue_body(rec, key, dev, a, local)
            cmd = ["gh", "issue", "create", "-R", repo, "--title", title, "--body", body]
            labels = labels_of(rec)
            rc, out, err = run(cmd + [arg for label in labels for arg in ("--label", label)], timeout=90)
            if rc != 0 and "label" in err.lower():
                log("tracker_retry", tracker="github", repo=repo, reason=f"no {','.join(labels)} label",
                    stderr=tail(err))
                rc, out, err = run(cmd, timeout=90)
            if rc != 0:
                log("tracker_error", tracker="github", repo=repo, step="create", rc=rc, stderr=tail(err))
                return "error", None
            url = out.strip().splitlines()[-1]
            markers = self.filed_markers.setdefault(repo, set())
            if markers is not None:
                if at and rec.get("kind") != "crash":
                    markers.add(f"<!-- bug:{at} -->")
                if rec.get("id"):
                    markers.add(f"<!-- bug-id:{rec['id']} -->")
                elif at:
                    self.legacy_markers.setdefault(repo, set()).add(f"<!-- bug:{at} -->")
            return "filed", url
        if kind == "beads":
            if DRY:
                return "would_file", f"beads in {a.get('repo')}: {beads_title(rec)}"
            if not a.get("repo"):
                log("tracker_error", tracker="beads", step="config", message="beads needs the app's repo path")
                return "error", None
            desc = issue_body(rec, key, dev, a, local)
            rc, out, err = run(["bd", "create", beads_title(rec), "-t", "bug", "-p", "2",
                                "-l", ",".join(["from-app"] + labels_of(rec)[1:]),
                                "-d", desc, "--json"], timeout=90, cwd=Path(a["repo"]))
            if rc != 0:
                log("tracker_error", tracker="beads", repo=a["repo"], step="create", rc=rc, stderr=tail(err))
                return "error", None
            try:
                bead = json.loads(out).get("id")
            except ValueError:
                bead = (re.findall(r"\b[a-z][a-z0-9]*-[a-z0-9]+\b", out) or [None])[0]
            return "filed", bead or out.strip()[:80]
        log("tracker_error", tracker=kind, step="config", message="unknown tracker kind")
        return "error", None


def notify(title: str, body: str) -> None:
    if DRY:
        return
    if not shutil.which("herdr"):
        log("notify", ok=False, reason="herdr not on PATH")
        return
    rc, _, err = run(["herdr", "notification", "show", title, "--body", body, "--sound", "request"], timeout=20)
    log("notify", ok=rc == 0, title=title, **({"rc": rc, "stderr": tail(err)} if rc else {}))


# --- crash discovery and delivery ---------------------------------------------------------------------------


def parse_time(value: Any) -> Optional[dt.datetime]:
    try:
        parsed = dt.datetime.fromisoformat(str(value).replace("Z", "+00:00"))
        return parsed.astimezone(dt.timezone.utc) if parsed.tzinfo else None
    except ValueError:
        return None


def crash_record(path: Path, a: dict, dev: dict) -> Optional[dict]:
    """One issue per diagnostic file. Renaming to .reported.txt never changes its identity."""
    name = path.name.replace(".reported.txt", ".txt")
    match = re.fullmatch(r"(signal|exception)-(\d+)\.txt", name)
    context = {}
    if match:
        kind = match[1]
        occurred = dt.datetime.fromtimestamp(int(match[2]), dt.timezone.utc)
        if not path.read_text(errors="replace").strip():
            raise ValueError("empty crash file")
        # Keep stack contents local: a generic title is enough to find the evidence.
        note = f"Automatic {kind} crash: {name}"
    elif re.fullmatch(r"\d{8}-\d{6}\.json", name):
        payload = json.loads(path.read_text())
        if not isinstance(payload, dict):
            raise ValueError("MetricKit payload is not an object")
        crashes, hangs = payload.get("crashDiagnostics", []), payload.get("hangDiagnostics", [])
        if not crashes and not hangs:
            return None
        kind = "metrickit"
        occurred = dt.datetime.strptime(path.stem, "%Y%m%d-%H%M%S").replace(tzinfo=dt.timezone.utc)
        context = {"crash_count": len(crashes), "hang_count": len(hangs), "time_basis": "payload interval end"}
        note = f"Automatic MetricKit diagnostics: {len(crashes)} crash(es), {len(hangs)} hang(s), {name}"
    else:
        return None
    identity = hashlib.sha256(f"{a['bundle']}|{dev['id']}|{name}".encode()).hexdigest()
    return {"id": f"crash:{identity}", "kind": "crash", "app": a["name"], "bundle": a["bundle"],
            "reported_at": occurred.isoformat().replace("+00:00", "Z"), "note": note,
            "files": [f"crashes/{name}"], "context": {"diagnostic_kind": kind, **context}}


def attach_crash_session(rec: dict, logs: Path) -> None:
    """Signal/exception epochs can suggest a preceding session. MetricKit delivery time cannot."""
    rec["context"]["session_match"] = "unknown"
    if rec["context"]["diagnostic_kind"] == "metrickit":
        return
    occurred = parse_time(rec["reported_at"])
    candidates = []
    for path in logs.rglob("*.jsonl") if logs.exists() else []:
        try:
            with path.open(errors="replace") as f:
                start = json.loads(f.readline())
            began = parse_time(start.get("started"))
            if start.get("type") == "session_start" and began and occurred and began <= occurred:
                candidates.append((began, path, start))
        except (OSError, ValueError, AttributeError):
            continue
    if candidates:
        began, path, start = max(candidates, key=lambda item: (item[0], item[1].name))
        rec["log"] = f"logs/{path.relative_to(logs).as_posix()}"
        rec["session_t_ms"] = int((occurred - began).total_seconds() * 1000)
        rec["context"]["session_match"] = "inferred: latest session_start before crash"
        for field in ("build", "commit"):
            if field in start:
                rec[field] = start[field]


def pending(entry: dict, rec: dict, reason: str, a: dict, dev: dict) -> None:
    items = entry.setdefault("pending", {})
    first = items.get(rec["id"], {}).get("first_seen", now())
    items[rec["id"]] = {"key": rec["id"], "app": a["name"], "device": dev["dir"],
                        "kind": rec.get("kind", "report"), "reason": reason,
                        "first_seen": first, "last_attempt": now()}


def deliver(filer: Filer, a: dict, rec: dict, dev: dict, local: Path, entry: dict,
            keys_field: str, seen: dict, summary: dict, key: Optional[str] = None) -> bool:
    key = key or rec["id"]
    prior = seen.get("_deliveries", {}).get(a["bundle"] + ":" + key)
    outcome, ref = ("already_filed", prior.get("ref")) if prior is not None else filer.file(a, rec, key, dev, local)
    log("file", key=key, outcome=outcome, ref=ref, tracker=a["tracker"]["kind"], app=a["name"], device=dev["dir"])
    if outcome == "error":
        summary["errors"] += 1
        pending(entry, {**rec, "id": key}, "tracker", a, dev)
        save_seen(seen)
        return False
    if outcome == "would_file":
        summary["would_file"] += 1
        print(f"  WOULD FILE {a['name']} / {dev['dir']} {key}\n{issue_body(rec, key, dev, a, local)}", flush=True)
        return False
    if outcome == "filed":
        summary["filed"] += 1
    if not DRY:
        if rec.get("id"):
            seen.setdefault("_deliveries", {})[a["bundle"] + ":" + key] = {"ref": ref, "inbox": False}
            pending(entry, {**rec, "id": key}, "inbox", a, dev)
            save_seen(seen)  # retain tracker acknowledgement even when the inbox append fails
        with INBOX.open("a") as f:
            f.write(json.dumps({"t": now(), "app": a["name"], "bundle": a["bundle"], "repo": a.get("repo"), "device": dev["dir"],
                                "key": key, "kind": rec.get("kind", "report"), "reported_at": rec.get("reported_at"),
                                "note": rec.get("note"), "tracker": a["tracker"]["kind"], "ref": ref,
                                "dir": str(local)}, ensure_ascii=False) + "\n")
            f.flush()
            os.fsync(f.fileno())
        if rec.get("id"):
            seen.setdefault("_deliveries", {})[a["bundle"] + ":" + key] = {"ref": ref, "inbox": True}
        log("inbox", key=key, app=a["name"], device=dev["dir"], ref=ref)
        notify(f"Bug: {a['name']}", f"{title_of(rec)} ({dev['type']}) {ref or ''}".strip())
    entry[keys_field].append(key)
    entry.setdefault("pending", {}).pop(key, None)
    save_seen(seen)
    return True


def already_filed(filer: Filer, a: dict, rec: dict, dev: dict, entry: dict, keys_field: str,
                  seen: dict, summary: dict, key: Optional[str] = None) -> bool:
    key = key or rec["id"]
    prior = seen.get("_deliveries", {}).get(a["bundle"] + ":" + key) if rec.get("id") else None
    inbox_prior = seen.get("_inbox_deliveries", {}).get(a["name"] + ":" + key) if rec.get("id") else None
    if prior is not None and prior.get("inbox") is False and inbox_prior is None:
        return False  # tracker filed; retry the durable agent handoff without creating another issue
    prior = prior or inbox_prior
    stop = ("already_filed", prior.get("ref")) if prior is not None else filer.check(a, rec)
    if stop is None:
        return False
    if stop[0] == "error":
        summary["errors"] += 1
        pending(entry, {**rec, "id": key}, "tracker_lookup", a, dev)
    else:
        summary["skipped"] += 1
        entry[keys_field].append(key)
        entry.setdefault("pending", {}).pop(key, None)
    log("file", key=key, outcome=stop[0], ref=stop[1], app=a["name"], device=dev["dir"])
    save_seen(seen)
    return True


def app_filed_ref(a: dict, rec: dict) -> Optional[str]:
    """An app's own filer (Magic Monitor's `just file-bugs`) writes the beads id into its report.json."""
    folder = folder_of(rec)
    if not folder:
        return None
    try:
        data = json.loads(store_evidence_path(Path(a["mac_dir"]), folder + "/report.json", scope="Mac").read_text())
    except (OSError, ValueError):
        return None
    ref = data.get("beads") if isinstance(data, dict) else None
    return ref if isinstance(ref, str) and ref else None


def record_app_receipt(a: dict, rec: dict, key: str, ref: str, seen: dict) -> None:
    # Bundle-wide, so the same report arriving via CloudKit or a paired device is not refiled.
    if rec.get("id") and not DRY:
        seen.setdefault("_deliveries", {})[a["bundle"] + ":" + key] = {"ref": ref, "inbox": True, "by_app": True}


def filed_by_app(a: dict, rec: dict, dev: dict, entry: dict, seen: dict, summary: dict, key: str) -> bool:
    ref = app_filed_ref(a, rec)
    if ref is None:
        return False
    summary["skipped"] += 1
    entry["keys"].append(key)
    entry.setdefault("pending", {}).pop(key, None)
    record_app_receipt(a, rec, key, ref, seen)
    log("file", key=key, outcome="filed_by_app", ref=ref, app=a["name"], device=dev["dir"])
    save_seen(seen)
    return True


def poll_reports(a: dict, dev: dict, local: Path, locked: Any, seen: dict, filer: Filer,
                 summary: dict, backfill: bool) -> None:
    ctx = {"device": dev["dir"], "app": a["name"]}
    # Read a fresh snapshot. A missing index must not replay a stale local copy.
    with tempfile.TemporaryDirectory() as tmp:
        index = Path(tmp) / "bugs.jsonl"
        if not copy(dev, a, "Documents/bugs.jsonl", index, locked, allow_missing=True):
            summary["errors"] += 1
            return
        reports = read_index(index, ctx) if index.exists() else []
        if index.exists():
            local.mkdir(parents=True, exist_ok=True)
            shutil.copy2(index, local / "bugs.jsonl")
    pair = f"{a['bundle']}|{dev['id']}"
    entry = seen.setdefault(pair, {"since": now()})
    first = "keys" not in entry
    known = set(entry.get("keys", []))
    fresh = dict((k, r) for k, r in reports if k not in known)
    log("index", reports=len(reports), new=len(fresh), first_contact=first, **ctx)
    if first and not backfill:
        # Baseline only what is already filed (#65): a report the app's own filer never filed is filed now, the
        # same marker lookup `pull-reports.sh --check` does. Without a readable tracker, set no baseline yet.
        unfiled = set()
        app_refs = {}
        for key, rec in reports:
            ref = app_filed_ref(a, rec) if dev.get("type") == "Mac" else None
            if ref:
                app_refs[key] = (rec, ref)
                continue
            stop = filer.check(a, rec)
            if stop is not None and stop[0] == "error":
                summary["errors"] += 1
                log("baseline_deferred", reason="tracker_lookup", **ctx)
                return
            if stop is None and a["tracker"].get("kind") == "github":
                unfiled.add(key)
        for key, (rec, ref) in app_refs.items():
            record_app_receipt(a, rec, key, ref, seen)
        entry["keys"] = sorted(set(k for k, _ in reports) - unfiled)
        summary["baselined"] += len(entry["keys"])
        log("baseline", marked_seen=len(entry["keys"]), unfiled=len(unfiled), **ctx)
        save_seen(seen)
        fresh = {k: r for k, r in fresh.items() if k in unfiled}
        if not fresh:
            return
    entry.setdefault("keys", [])
    save_seen(seen)
    for key, rec in fresh.items():
        summary["new"] += 1
        log("report", key=key, reported_at=rec.get("reported_at"), title=title_of(rec), **ctx)
        if dev.get("type") == "Mac" and filed_by_app(a, rec, dev, entry, seen, summary, key):
            continue
        if already_filed(filer, a, rec, dev, entry, "keys", seen, summary, key):
            continue
        folder = folder_of(rec)
        evidence_ok = not folder or copy(dev, a, under_documents(folder), local / folder, locked)
        src = log_source(rec, a)
        if src:
            log_ok = copy(dev, a, src, local / "logs" / Path(src).name, locked)
            evidence_ok = evidence_ok and log_ok
        if not evidence_ok:
            summary["errors"] += 1
            pending(entry, {**rec, "id": key}, "evidence", a, dev)
            log("evidence_pending", key=key, **ctx)
            save_seen(seen)
            continue
        deliver(filer, a, rec, dev, local, entry, "keys", seen, summary, key)


def poll_crashes(a: dict, dev: dict, local: Path, locked: Any, seen: dict, filer: Filer,
                 summary: dict, backfill: bool) -> None:
    ctx = {"device": dev["dir"], "app": a["name"]}
    pair = f"{a['bundle']}|{dev['id']}"
    with tempfile.TemporaryDirectory() as tmp:
        snapshot = Path(tmp) / "crashes"
        if not copy(dev, a, a.get("crash_dir", "Documents/crashes"), snapshot, locked, allow_missing=True):
            summary["errors"] += 1
            return
        records = {}
        for path in sorted(snapshot.glob("*")):
            if not path.is_file():
                continue
            try:
                rec = crash_record(path, a, dev)
                if rec:
                    dest = local / rec["files"][0]
                    dest.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(path, dest)
                    records[rec["id"]] = rec
            except (OSError, ValueError, TypeError, OverflowError) as e:
                summary["errors"] += 1
                log("crash_unreadable", file=path.name, message=str(e), **ctx)
        entry = seen.setdefault(pair, {"since": now()})
        first = "crash_keys" not in entry
        known = set(entry.setdefault("crash_keys", []))
        if first and not backfill:
            entry["crash_keys"] = sorted(records)
            summary["baselined"] += len(records)
            log("crash_baseline", marked_seen=len(records), **ctx)
            save_seen(seen)
            return
        save_seen(seen)
        fresh = [r for key, r in records.items() if key not in known]
        logs_ready = None
        logs = Path(tmp) / "logs"
        for rec in fresh:
            summary["new"] += 1
            summary["crashes"] += 1
            log("crash", key=rec["id"], file=rec["files"][0], **ctx)
            if already_filed(filer, a, rec, dev, entry, "crash_keys", seen, summary):
                continue
            if logs_ready is None:
                logs_ready = copy(dev, a, a.get("log_dir", "Documents/logs"), logs, locked, allow_missing=True)
                if logs_ready and logs.exists():
                    shutil.copytree(logs, local / "logs", dirs_exist_ok=True)
            if not logs_ready:
                summary["errors"] += 1
                pending(entry, rec, "crash_logs", a, dev)
                log("evidence_pending", key=rec["id"], **ctx)
                save_seen(seen)
                continue
            attach_crash_session(rec, logs)
            if rec["context"]["session_match"] == "unknown":
                rec["context"]["logs_directory"] = tilde(local / "logs") if logs.exists() else "unavailable on device"
            metadata = rec["files"][0] + ".report.json"
            rec["files"].append(metadata)
            (local / metadata).write_text(json.dumps(rec, indent=2, sort_keys=True) + "\n")
            deliver(filer, a, rec, dev, local, entry, "crash_keys", seen, summary)


# --- poll health --------------------------------------------------------------------------------------------


def read_status() -> dict:
    path = STATE / "status.json"
    data = json.loads(path.read_text()) if path.exists() else {}
    if not isinstance(data, dict):
        raise ValueError("status.json is not an object")
    return data


def save_status(data: dict) -> None:
    if DRY:
        return
    STATE.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(dir=STATE, prefix=".status-")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(data, f, indent=2, sort_keys=True)
        os.replace(name, STATE / "status.json")
    finally:
        Path(name).unlink(missing_ok=True)


def cloud_evidence_path(root: Path, name: str) -> Path:
    return store_evidence_path(root, name, scope="CloudKit")


def store_evidence_path(root: Path, name: str, *, scope: str) -> Path:
    if not isinstance(name, str) or not name or "\\" in name or "\0" in name:
        raise ValueError(f"invalid {scope} evidence path")
    if name.startswith("/") or any(p in ("", ".", "..") for p in name.split("/")):
        raise ValueError(f"invalid {scope} evidence path")
    resolved = (root / name).resolve()
    if not resolved.is_relative_to(root.resolve()):
        raise ValueError(f"{scope} evidence escapes its storage root")
    return resolved


CLOUD_PENDING_REASONS = ("download or evidence validation failed", "listing failed or record metadata is invalid")


def sync_cloudkit(cfg: dict, summary: dict, health: dict) -> None:
    cloud = cfg["cloudkit"]
    executable = Path(cloud["app"]) / "Contents/MacOS/BugKitCloudReader"
    if DRY:
        log("cloudkit_sync", skipped=True, reason="dry run; consume existing downloads only")
        return
    started = time.monotonic()
    log("cloudkit_poll")
    rc, out, _ = run([str(executable), "--container", cloud["container"], "--inbox", cloud["inbox"], "--environment", cloud["environment"]], timeout=180)
    completed = False
    downloaded = None
    failure = {}
    for line in out.splitlines():
        try:
            event = json.loads(line)
            if event.get("event") == "cloudkit_downloaded" and isinstance(event.get("id"), str):
                log("cloudkit_downloaded", key=event["id"], bundle=event.get("bundle"))
            elif event.get("event") == "cloudkit_report_pending":
                key = None
                with contextlib.suppress(ValueError, TypeError, AttributeError):
                    key = str(uuid.UUID(event.get("id"))).upper()
                reason = event.get("reason") if event.get("reason") in CLOUD_PENDING_REASONS else "unknown"
                log("cloudkit_report_pending", key=key, reason=reason)
            elif event.get("event") == "cloudkit_sync":
                if event.get("ok") is True:
                    count = event.get("downloaded")
                    completed = type(count) is int and count >= 0
                    downloaded = count if completed else None
                    if not completed:
                        failure["reason"] = "invalid_download_count"
                elif event.get("ok") is False:
                    code = event.get("code")
                    if type(code) is int and 0 <= code <= 9999:
                        failure["code"] = code
                    reason = event.get("reason")
                    if reason in ("missing_query_index", "sync_failed"):
                        failure["reason"] = reason
                    if failure.get("code") == 12 and reason == "missing_query_index":
                        failure["action"] = "add BugKitReport.recordName Queryable index in CloudKit Console"
        except (ValueError, AttributeError, TypeError):
            continue
    ok = rc == 0 and completed
    details = {"downloaded": downloaded} if ok else failure
    health["cloudkit"] = {"ok": ok, "last_attempt": now(), "rc": rc, **details}
    if ok:
        summary["reachable"] += 1
    else:
        summary["errors"] += 1
    log("cloudkit_sync", ok=ok, rc=rc, ms=int((time.monotonic() - started) * 1000), **details)


def poll_cloud_reports(cfg: dict, seen: dict, filer: Filer, summary: dict, backfill: bool) -> None:
    """Consume complete folders published by the signed CloudKit helper, without contacting iCloud here."""
    inbox = Path(cfg["cloudkit"]["inbox"])
    if not inbox.is_dir():
        return  # the helper creates it on its first successful sync; a failed sync is already an error
    apps = {a["bundle"]: a for a in cfg["apps"]}
    for folder in sorted(inbox.iterdir()):
        if not folder.is_dir() or folder.is_symlink() or folder.name.startswith("."):
            continue
        try:
            identity = str(uuid.UUID(folder.name)).upper()
        except ValueError:
            continue
        try:
            rec = json.loads((folder / "report.json").read_text())
            if not isinstance(rec, dict) or rec.get("id") != identity:
                raise ValueError("CloudKit folder and report UUID differ")
            a = apps.get(rec.get("bundle"))
            if a is None:
                continue
            dev = {"id": "cloudkit", "dir": "cloudkit", "type": "CloudKit", "model": rec.get("device", "unknown")}
            pair = a["bundle"] + "|cloudkit"
            entry = seen.setdefault(pair, {"since": now(), "keys": []})
            key = rec["id"]
            if key in entry["keys"]:
                continue
            summary["new"] += 1
            if already_filed(filer, a, rec, dev, entry, "keys", seen, summary):
                continue
            documents = folder / "Documents"
            if documents.is_symlink():
                raise ValueError("CloudKit Documents cannot be a symlink")
            paths = rec.get("files", []) + [p for p in (rec.get("screenshot"), rec.get("log")) if p]
            sizes = json.loads((folder / "files.json").read_text())
            if not isinstance(sizes, dict) or set(sizes) != set(paths):
                raise ValueError("CloudKit evidence manifest differs from report")
            if not all(isinstance(sizes[p], int) and not isinstance(sizes[p], bool) and sizes[p] >= 0
                       and cloud_evidence_path(documents, p).is_file()
                       and cloud_evidence_path(documents, p).stat().st_size == sizes[p] for p in paths):
                pending(entry, rec, "cloudkit_evidence", a, dev)
                summary["errors"] += 1
                save_seen(seen)
                continue
            # The helper's inbox is explicit delivery, so do not baseline/suppress its first reports.
            deliver(filer, a, rec, dev, documents, entry, "keys", seen, summary)
        except (OSError, ValueError, TypeError, KeyError) as error:
            summary["errors"] += 1
            log("cloudkit_report_error", folder=folder.name, message=str(error))


def poll(cfg: dict, backfill: bool) -> dict:
    t0 = time.monotonic()
    health = read_status()
    health.update(last_poll_started=now(), in_progress=True, last_error=None,
                  poll_seconds=cfg.get("poll_seconds", 300))
    save_status(health)
    log("poll_start", apps=[a["name"] for a in cfg["apps"]])
    summary = {"devices": 0, "reachable": 0, "new": 0, "crashes": 0, "filed": 0, "would_file": 0,
               "skipped": 0, "baselined": 0, "errors": 0}
    try:
        seen = load_seen()
        filer = Filer()
        health["devices"] = []
        health["mac_stores"] = []
        devices = []
        for a in cfg["apps"]:
            if not a.get("mac_dir"):
                continue
            root = Path(a["mac_dir"])
            reachable = root.is_dir() and os.access(root, os.R_OK | os.X_OK)
            health["mac_stores"].append({"app": a["name"], "reachable": reachable})
            log("mac_store", app=a["name"], reachable=reachable)
            if not reachable:
                continue
            summary["reachable"] += 1
            dev = {"id": "local-mac", "dir": "mac", "type": "Mac", "model": "local Mac"}
            local = STATE / a["name"] / "mac"
            for action in (poll_reports, poll_crashes):
                try:
                    action(a, dev, local, False, seen, filer, summary, backfill)
                except (OSError, ValueError, TypeError) as error:
                    summary["errors"] += 1
                    log("app_poll_error", app=a["name"], device="mac", step=action.__name__, message=str(error))
        # After the Mac stores, so receipts for reports their apps filed themselves exist before CloudKit copies land.
        if cfg.get("cloudkit"):
            sync_cloudkit(cfg, summary, health)
            poll_cloud_reports(cfg, seen, filer, summary, backfill)
        try:
            devices = list_devices()
        except (OSError, ValueError, RuntimeError) as error:
            if not cfg.get("cloudkit") and not any(a.get("mac_dir") for a in cfg["apps"]):
                raise
            summary["errors"] += 1
            log("devices_error", message=str(error))
        for dev in devices:
            summary["devices"] += 1
            lock = probe(dev)
            health["devices"].append({"id": dev["id"], "device": dev["dir"], "reachable": lock is not None,
                                      "locked": lock.get("locked") if lock else None})
            if lock is None:
                continue
            summary["reachable"] += 1
            for a in cfg["apps"]:
                local = STATE / a["name"] / dev["dir"]
                # Independent streams: an absent or unreadable bug index must never suppress a crash.
                for action in (poll_reports, poll_crashes):
                    try:
                        action(a, dev, local, lock["locked"], seen, filer, summary, backfill)
                    except (OSError, ValueError, TypeError) as e:
                        summary["errors"] += 1
                        log("app_poll_error", app=a["name"], device=dev["dir"], step=action.__name__, message=str(e))
        summary["ms"] = int((time.monotonic() - t0) * 1000)
        health.update(last_poll_completed=now(), in_progress=False, summary=summary)
        if not summary["errors"] and summary["reachable"]:
            health["last_successful_poll"] = health["last_poll_completed"]
        save_status(health)
        log("poll_end", **summary)
        return summary
    except Exception as e:
        health.update(in_progress=False, last_error=str(e), last_poll_completed=now())
        save_status(health)
        raise


